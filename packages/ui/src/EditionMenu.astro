---
import type { NavigationLink } from './types'

interface Props {
  editions: readonly NavigationLink[]
}
const { editions } = Astro.props
const listId = `editions-${crypto.randomUUID()}`
---
<div data-header-editions class='relative'>
  <button type='button' aria-expanded='false' aria-controls={listId} class='cursor-pointer px-3 py-2 text-sm font-bold focus-visible:outline-2 focus-visible:outline-offset-2'>
    Ediciones <span aria-hidden='true'>▾</span>
  </button>
  <ul id={listId} data-editions-list hidden class='absolute right-0 top-full z-20 min-w-max rounded border border-[var(--header-border-color,currentColor)] bg-[var(--header-panel-bg-color,Canvas)] p-2 text-[color:var(--header-panel-text-color,CanvasText)] shadow-lg'>
    {editions.map(({ label, href }) => (
      <li><a href={href} class='block px-3 py-2 text-sm hover:underline focus-visible:outline-2 focus-visible:outline-offset-2'>{label}</a></li>
    ))}
  </ul>
</div>
