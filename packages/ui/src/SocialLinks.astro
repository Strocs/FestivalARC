---
import { Icon } from 'astro-icon/components'

const socials = [
  { label: 'Instagram', href: 'https://www.instagram.com/festival_arc', icon: 'simple-icons:instagram' },
  { label: 'Facebook', href: 'https://www.facebook.com/FestivalARC', icon: 'facebook-square' },
  { label: 'X', href: 'https://x.com/FestivalARC', icon: 'simple-icons:x' },
]
---

<nav aria-labelledby='social-links-heading' class='shrink-0 text-center pt-4 border-t border-primary/10'>
  <h2 id='social-links-heading' class='sr-only'>Redes Sociales</h2>
  <div class='flex justify-center gap-1'>
    {socials.map(({ label, href, icon }) => (
      <a
        href={href}
        aria-label={label}
        class='grid size-11 place-items-center rounded transition-colors hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-2'>
        <Icon name={icon} is:inline class='size-5' aria-hidden='true' />
      </a>
    ))}
  </div>
</nav>
