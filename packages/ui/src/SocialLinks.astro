---
import { Icon } from 'astro-icon/components'

const socials = [
  { label: 'Instagram', href: 'https://www.instagram.com/festival_arc', icon: 'simple-icons:instagram' },
  { label: 'Facebook', href: 'https://www.facebook.com/FestivalARC', icon: 'facebook-square' },
  { label: 'X', href: 'https://x.com/FestivalARC', icon: 'simple-icons:x' },
]
---

<div class='shrink-0 text-center'>
  <div class='flex justify-center gap-1'>
    {socials.map(({ label, href, icon }) => (
      <a
        href={href}
        aria-label={label}
        class='grid size-11 place-items-center rounded transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 [&]:text-foreground [&:hover]:text-accent'>
        <Icon name={icon} is:inline class='size-5' aria-hidden='true' />
      </a>
    ))}
  </div>
</div>
