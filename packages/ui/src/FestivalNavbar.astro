---
import EditionMenu from './EditionMenu.astro'
import type { NavigationLink } from './types'

interface Props {
  editions: readonly NavigationLink[]
  links?: readonly NavigationLink[]
  homeHref?: string
}
const { editions, links = [], homeHref = '/' } = Astro.props
for (const name of ['logo', 'date']) {
  if (!Astro.slots.has(name)) throw new Error(`FestivalNavbar requires the "${name}" slot`)
}
if (!Array.isArray(editions) || editions.length === 0) {
  throw new Error('FestivalNavbar requires at least one other edition')
}
const mobileLinks = [{ label: 'Inicio', href: homeHref }, ...links.filter(link => link.href !== homeHref && link.label !== 'Inicio')]
const panelId = `festival-navigation-${crypto.randomUUID()}`
const cta = Astro.slots.has('cta') ? await Astro.slots.render('cta') : ''
---
<festival-navbar class='contents'>
  <header data-festival-header class='relative z-30 border-[var(--header-border-color,currentColor)] bg-[var(--header-bg-color,transparent)] py-1 text-[color:var(--header-text-color,inherit)]'>
    <div class='relative mx-auto flex min-h-16 w-full items-center justify-between gap-3 px-4 py-2 sm:gap-6 sm:px-14'>
      <div data-header-brand class='flex min-w-0 items-center gap-3'>
        <a href={homeHref} aria-label='Inicio' class='block w-20 shrink-0 focus-visible:outline-2 focus-visible:outline-offset-2 sm:w-32'>
          <slot name='logo' />
        </a>
        <div class='min-w-0 text-xs leading-4 sm:text-sm'>
          <div data-header-date class='font-bold'><slot name='date' /></div>
          {Astro.slots.has('location') && <div data-header-location><slot name='location' /></div>}
        </div>
      </div>
      <nav data-header-nav aria-label='Navegación principal' class='hidden shrink-0 items-center gap-4 lg:flex'>
        {links.length > 0 && <ul class='flex items-center gap-4'>
          {links.map(({ label, href }) => <li><a href={href} class='hover:underline focus-visible:outline-2 focus-visible:outline-offset-2'>{label}</a></li>)}
        </ul>}
        {cta && <div data-header-cta set:html={cta} />}
        <EditionMenu editions={editions} />
      </nav>
      <button data-header-toggle type='button' aria-label='Abrir navegación' aria-controls={panelId} aria-expanded='false' class='group shrink-0 cursor-pointer p-2 focus-visible:outline-2 focus-visible:outline-offset-2 lg:hidden'>
        <svg data-icon-menu aria-hidden='true' width='24' height='24' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round'>
          <path data-icon-line='top' d='M4 12h16' class='origin-[12px_12px] -translate-y-[6px] transition-transform duration-300 ease-[cubic-bezier(0.34,1.56,0.64,1)] group-data-[icon-open=true]:translate-y-0 group-data-[icon-open=true]:rotate-45 motion-reduce:transition-none' />
          <path data-icon-line='middle' d='M4 12h8' class='origin-[4px_12px] transition-[transform,opacity] duration-200 group-data-[icon-open=true]:scale-x-0 group-data-[icon-open=true]:opacity-0 motion-reduce:transition-none' />
          <path data-icon-line='bottom' d='M4 12h16' class='origin-[12px_12px] translate-y-[6px] transition-transform duration-300 ease-[cubic-bezier(0.34,1.56,0.64,1)] group-data-[icon-open=true]:translate-y-0 group-data-[icon-open=true]:-rotate-45 motion-reduce:transition-none' />
        </svg>
      </button>
    </div>
  </header>
  <dialog id={panelId} data-header-panel aria-label='Navegación del festival' class='fixed inset-0 m-0 h-dvh max-h-none w-full max-w-none overflow-hidden border-0 bg-transparent p-0 text-[color:var(--header-panel-text-color,CanvasText)] backdrop:bg-transparent'>
    <div data-header-surface class='absolute inset-0 flex flex-col gap-8 overflow-y-auto bg-[var(--header-panel-bg-color,Canvas)] px-6 pb-6 pt-[var(--navigation-header-height)]'>
      <nav aria-label='Navegación móvil' class='my-auto flex flex-col items-center gap-6 text-center'>
        {<ul class='flex flex-col items-center gap-6 text-2xl'>
          {mobileLinks.map(({ label, href }) => <li><a href={href} class='hover:underline focus-visible:outline-2 focus-visible:outline-offset-2'>{label}</a></li>)}
        </ul>}
        {cta && <div data-header-cta set:html={cta} />}
        <EditionMenu editions={editions} expanded />
      </nav>
      <slot name='mobile-extra' />
    </div>
  </dialog>
</festival-navbar>

<script>
  class FestivalNavbar extends HTMLElement {
    private cleanup?: () => void

    connectedCallback() {
      if (this.cleanup) return
      const panel = this.querySelector<HTMLDialogElement>('[data-header-panel]')!
      const toggle = this.querySelector<HTMLButtonElement>('[data-header-toggle]')!
      const header = this.querySelector<HTMLElement>('[data-festival-header]')!
      const surface = this.querySelector<HTMLElement>('[data-header-surface]')!
      let placeholder: HTMLDivElement | undefined
      const setExpanded = (open: boolean) => {
        toggle.setAttribute('aria-expanded', String(open))
        toggle.setAttribute('aria-label', open ? 'Cerrar navegación' : 'Abrir navegación')
        toggle.dataset.iconOpen = String(open)
        toggle.style.transform = open ? 'rotate(-90deg)' : 'rotate(0deg)'
      }
      const restoreHeader = () => {
        placeholder?.replaceWith(header)
        placeholder = undefined
      }
      const controller = new AbortController()
      const { signal } = controller
      const desktop = window.matchMedia('(min-width: 64rem)')
      let previousOverflow = ''
      let locked = false
      const restoreScroll = () => {
        if (!locked) return
        document.documentElement.style.overflow = previousOverflow
        locked = false
      }
      const cancelMotion = () => {
        surface.getAnimations().forEach(animation => animation.cancel())
        toggle.getAnimations().forEach(animation => animation.cancel())
      }
      let closing = false
      const closePanel = () => {
        if (!panel.open || closing) return
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          cancelMotion()
          panel.close()
          return
        }
        closing = true
        toggle.dataset.iconOpen = 'false'
        const surfaceTransform = getComputedStyle(surface).transform
        const toggleTransform = getComputedStyle(toggle).transform
        cancelMotion()
        toggle.animate([{ transform: toggleTransform }, { transform: 'rotate(0deg)' }], { duration: 300, easing: 'ease', fill: 'forwards' })
        const exit = surface.animate([{ transform: surfaceTransform }, { transform: 'translateX(100%)' }], { duration: 500, easing: 'ease', fill: 'forwards' })
        exit.onfinish = () => panel.close()
      }
      panel.addEventListener('cancel', event => {
        event.preventDefault()
        closePanel()
      }, { signal })
      toggle.addEventListener('click', () => {
        if (panel.open) {
          closePanel()
          return
        }
        previousOverflow = document.documentElement.style.overflow
        const height = header.getBoundingClientRect().height
        placeholder = document.createElement('div')
        placeholder.style.height = `${height}px`
        header.before(placeholder)
        // Keep the original header and control above the surface, inside the modal top layer.
        panel.prepend(header)
        panel.style.setProperty('--navigation-header-height', `${height}px`)
        panel.showModal()
        setExpanded(true)
        toggle.focus()
        if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          surface.animate([{ transform: 'translateX(100%)' }, { transform: 'translateX(0)' }], { duration: 500, easing: 'ease' })
          toggle.animate([{ transform: 'rotate(0)' }, { transform: 'rotate(-90deg)' }], { duration: 300, easing: 'ease' })
        }
        document.documentElement.style.overflow = 'hidden'
        locked = true
      }, { signal })
      panel.addEventListener('close', () => {
        closing = false
        cancelMotion()
        restoreScroll()
        restoreHeader()
        setExpanded(false)
        if (!desktop.matches && this.isConnected) toggle.focus()
      }, { signal })
      panel.addEventListener('click', event => {
        if ((event.target as Element).closest('a')) closePanel()
      }, { signal })
      desktop.addEventListener('change', () => {
        if (desktop.matches) closePanel()
      }, { signal })

      this.querySelectorAll<HTMLElement>('[data-header-editions]').forEach(menu => {
        if (menu.hasAttribute('data-editions-expanded')) return
        const button = menu.querySelector<HTMLButtonElement>('button')!
        const list = menu.querySelector<HTMLUListElement>('ul')!
        const setOpen = (open: boolean) => {
          button.setAttribute('aria-expanded', String(open))
          list.hidden = !open
          if (open && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
            list.animate([{ opacity: 0, transform: 'translateY(0.5rem)' }, { opacity: 1, transform: 'translateY(0)' }], { duration: 180, easing: 'ease' })
          }
        }
        button.addEventListener('click', () => setOpen(list.hidden), { signal })
        menu.addEventListener('focusout', event => {
          if (!menu.contains(event.relatedTarget as Node | null)) setOpen(false)
        }, { signal })
        menu.addEventListener('keydown', event => {
          if (event.key !== 'Escape') return
          setOpen(false)
          if (!panel.open) {
            event.stopPropagation()
            button.focus()
          }
        }, { signal })
        document.addEventListener('click', event => {
          if (!menu.contains(event.target as Node)) setOpen(false)
        }, { signal })
        panel.addEventListener('close', () => setOpen(false), { signal })
      })

      this.cleanup = () => {
        controller.abort()
        panel.close()
        restoreHeader()
        setExpanded(false)
        restoreScroll()
      }
      document.addEventListener('astro:before-swap', () => this.cleanup?.(), { signal, once: true })
    }

    disconnectedCallback() {
      this.cleanup?.()
      this.cleanup = undefined
    }
  }

  if (!customElements.get('festival-navbar')) customElements.define('festival-navbar', FestivalNavbar)
</script>
