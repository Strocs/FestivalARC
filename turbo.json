{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "type": {
      "dependsOn": ["^type"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^test"],
      "outputs": []
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".astro/**"]
    },
    "distribution": {
      "dependsOn": ["build"],
      "outputs": [".output/**"]
    }
  }
}
