---
import Layout from '../../layouts/Layout.astro'
import ArtistDetail from '../../features/artists/ArtistDetail.astro'
import { artists } from '../../features/artists/artists'
import { publicPath } from '../../utils/publication'

export function getStaticPaths() {
  return artists.map(artist => ({ params: { slug: artist.id }, props: { artist } }))
}
const { artist } = Astro.props
---
<Layout title={`${artist.name} | Festival ARC 2026`} description={artist.description || `${artist.name} · Festival ARC 2026`}>
  <main class='flex-1' aria-label={`Ficha de ${artist.name}`}>
    <a class='inline-block px-4 py-4 text-primary underline sm:px-8' href={publicPath('/')}>Volver a la portada</a>
    <ArtistDetail artist={artist} />
  </main>
</Layout>
