---
import { Image } from 'astro:assets'
import Layout from '../layouts/Layout.astro'
import logoHero from '../assets/LOGO_HERO.jpg'
---
<Layout>
  <main class='flex flex-1 flex-col items-center justify-center overflow-hidden px-5 py-12 text-center font-sans text-foreground sm:px-8 lg:px-12' aria-labelledby='page-title'>
    <div class='relative aspect-[10/3] w-full max-w-[72rem] overflow-hidden'>
      <Image src={logoHero} alt='Festival ARC 2026' class='block size-full object-cover object-center' loading='eager' />
    </div>
    <h1 id='page-title' class='mt-8 text-[clamp(2rem,5vw,4.5rem)] font-bold leading-tight tracking-tight'>
      <span class='text-accent'>Revisa</span> nuestras <span class='text-accent'>redes</span>
    </h1>
    <nav class='mt-10 flex flex-wrap justify-center gap-6 text-[clamp(1rem,2vw,1.3rem)] font-semibold text-primary' aria-label='Redes sociales'>
      <a class='underline underline-offset-4 hover:text-accent' href='https://www.instagram.com/festival_arc' target='_blank' rel='noopener noreferrer'>Instagram</a>
      <a class='underline underline-offset-4 hover:text-accent' href='https://www.facebook.com/FestivalARC' target='_blank' rel='noopener noreferrer'>Facebook</a>
      <a class='underline underline-offset-4 hover:text-accent' href='https://x.com/FestivalARC' target='_blank' rel='noopener noreferrer'>X</a>
    </nav>
  </main>
</Layout>
