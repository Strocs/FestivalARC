---
import { arc26Logo } from '../features/arc2026/data/artwork'
import PreviousEditions from './PreviousEditions.astro'
import { publicPath } from '../utils/publication'
---
<header class='site-header sticky top-0 z-10 border-b border-primary/10 bg-background px-4 sm:px-8 [&_nav_*]:transition-none [&_nav_*]:transform-none'>
  <div class='flex w-full items-center justify-between gap-2'>
    <a href={publicPath('/')} aria-label='Ir al inicio' class='block shrink-0'>
      <img src={publicPath(arc26Logo.src)} width={arc26Logo.width} height={arc26Logo.height} alt='Logotipo del Festival ARC 2026' class='block h-auto w-24 sm:w-28' loading='eager' />
    </a>
    <PreviousEditions />
  </div>
</header>
