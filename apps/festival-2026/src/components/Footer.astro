---
import { Image } from 'astro:assets'
import SocialLinks from '@festivalarc/ui/SocialLinks.astro'
import footerLogos from '../assets/logos-footer.png'
---
<footer data-festival-footer class='relative border-t border-primary/10 px-4 py-3 sm:px-8 sm:py-4 lg:px-12'>
  <div class='mx-auto flex max-w-4xl flex-col items-center justify-center gap-4 md:flex-row md:gap-8'>
    <nav aria-labelledby='footer-socials-heading' class='shrink-0 text-center'>
      <h2 id='footer-socials-heading' class='text-sm font-semibold'>Redes Sociales</h2>
      <SocialLinks />
    </nav>
    <Image
      src={footerLogos}
      width={576}
      widths={[320, 576, 1152]}
      sizes='(min-width: 832px) 576px, (min-width: 768px) calc(100vw - 16rem), (min-width: 608px) 576px, calc(100vw - 2rem)'
      loading='lazy'
      alt='Logotipos de organizadores y colaboradores del Festival ARC 2026'
      class='block h-auto w-full min-w-0 max-w-xl'
    />
  </div>
</footer>
