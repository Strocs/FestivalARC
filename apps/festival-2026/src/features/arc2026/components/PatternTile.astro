---
import type { Motif } from '../data/composition'
interface Props { motif: Motif }
const { motif } = Astro.props
const motifColors = {
  arrows: '[--pattern-ground:var(--color-accent)] [--pattern-mark:var(--color-arc-rose)]',
  bolt: '[--pattern-ground:var(--color-accent)] [--pattern-mark:var(--color-primary)]',
  star: '[--pattern-ground:var(--color-accent)] [--pattern-mark:var(--color-arc-rose)]',
  spark: '[--pattern-ground:var(--color-arc-yellow)] [--pattern-mark:var(--color-arc-rose)]',
  petals: '[--pattern-ground:var(--color-arc-rose)] [--pattern-mark:var(--color-arc-yellow)]',
  orbits: '[--pattern-ground:var(--color-primary)] [--pattern-mark:var(--color-accent)]',
} satisfies Record<Motif, string>
---
<!-- Geometric reconstructions of the supplied raster poster, not original vectors. -->
<svg class:list={['block w-full aspect-square', motifColors[motif]]} viewBox='0 0 100 100' aria-hidden='true' focusable='false'>
  <rect width='100' height='100' fill='var(--pattern-ground)' />
  <g fill='var(--pattern-mark)'>
    {motif === 'arrows' && <path d='M0 0H50L100 50 50 100H0L50 50Z' />}
    {motif === 'bolt' && <path d='M20 0H42L20 53V100H0L20 47ZM62 0H84L62 53V100H42L62 47Z' />}
    {motif === 'star' && <path d='M50 2 57 34 82 14 66 40 98 42 68 55 91 74 61 65 66 97 50 70 34 97 39 65 9 74 32 55 2 42 34 40 18 14 43 34Z' />}
    {motif === 'spark' && <path d='M0 50Q25 50 25 0Q25 50 50 50Q25 50 25 100Q25 50 0 50ZM50 50Q75 50 75 0Q75 50 100 50Q75 50 75 100Q75 50 50 50Z' />}
    {motif === 'petals' && <>
      <circle cx='50' cy='50' r='25' />
      <path d='M3 25A22 22 0 0 1 25 3V25ZM25 25A25 25 0 0 1 75 25ZM75 3A22 22 0 0 1 97 25H75ZM25 25A25 25 0 0 0 25 75ZM75 25A25 25 0 0 1 75 75ZM3 75H25V97A22 22 0 0 1 3 75ZM25 75A25 25 0 0 0 75 75ZM75 75H97A22 22 0 0 1 75 97Z' />
    </>}
    {motif === 'orbits' && <>
      <rect x='7' y='7' width='86' height='86' rx='36' transform='rotate(45 50 50)' />
      <rect x='15' y='15' width='70' height='70' rx='28' transform='rotate(45 50 50)' fill='var(--pattern-ground)' />
      <rect x='24' y='24' width='52' height='52' rx='20' transform='rotate(45 50 50)' />
      <circle cx='50' cy='50' r='18' fill='var(--pattern-ground)' />
    </>}
  </g>
</svg>
