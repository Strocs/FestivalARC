---
import headline from '../../../assets/LOGO_HERO.png'
import { publicPath } from '../../../utils/publication'
---
<header class='poster-intro relative h-full'>
  <p class='reference-dates absolute top-[calc(32*var(--unit))] left-0 m-0 text-(--poster-text) text-[length:calc(48*var(--unit))] font-black leading-[calc(54*var(--unit))] [@media(max-width:767px)]:top-[calc(16*var(--unit))] [@media(max-width:767px)]:text-[length:calc(28*var(--unit))] [@media(max-width:767px)]:leading-[calc(32*var(--unit))]' aria-label='28 y 29 de noviembre de 2026'>
    <span aria-hidden='true'>28.11<br />29.11</span>
  </p>
  <h1 id='page-title' class='absolute top-[calc(168*var(--unit))] left-0 w-[calc(640*var(--unit))] m-0 [@media(max-width:767px)]:top-[calc(88*var(--unit))] [@media(max-width:767px)]:w-[calc(320*var(--unit))]'>
    <span class='sr-only'>El arte de habitar la ciudad</span>
    <svg class='block w-full h-auto overflow-hidden' viewBox='1068 28 725 465' aria-hidden='true' focusable='false'>
      <image href={publicPath(headline.src)} width={headline.width} height={headline.height} />
    </svg>
  </h1>
</header>
