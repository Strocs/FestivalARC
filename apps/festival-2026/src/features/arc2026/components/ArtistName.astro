---
import type { LineupArtist } from '../data/lineup'
interface Props { artist: LineupArtist }
const { artist } = Astro.props
const chevronClasses = 'chevron absolute top-1/2 w-[calc(30*var(--unit))] h-[calc(34*var(--unit))] [transform:translateY(-50%)] fill-current'
---
<article class='artist-name flex w-full h-full min-w-0 bg-background' aria-label={artist.name}>
  <div class='artist-panel grid place-items-center relative w-full min-w-0 my-[calc(21*var(--unit))] mx-[calc(32*var(--unit))] px-[calc(7*var(--unit))] bg-accent text-background'>
    <svg class:list={[chevronClasses, 'left left-[calc(7*var(--unit))]']} viewBox='0 0 36 40' aria-hidden='true' focusable='false'>
      <path d='M15 2H25L8 20 25 38H15L0 20ZM29 2H36L19 20 36 38H29L12 20Z' />
    </svg>
    <span class='artist-label block w-max max-w-[calc(240*var(--unit))] py-[calc(3*var(--unit))] px-[calc(5*var(--unit))] rounded-[calc(10*var(--unit))] bg-primary font-sans text-[length:calc(26*var(--unit))] font-black leading-[calc(24*var(--unit))] text-center uppercase [overflow-wrap:anywhere] [transform:scaleX(.8)]'>{artist.name}</span>
    <svg class:list={[chevronClasses, 'right right-[calc(7*var(--unit))]']} viewBox='0 0 36 40' aria-hidden='true' focusable='false'>
      <path transform='translate(36 0) scale(-1 1)' d='M15 2H25L8 20 25 38H15L0 20ZM29 2H36L19 20 36 38H29L12 20Z' />
    </svg>
  </div>
</article>
