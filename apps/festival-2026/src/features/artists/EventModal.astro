---
import ArtistDetail from './ArtistDetail.astro'
import { usesCompactParticipantDetails, type ParticipantView } from './categories'
interface Props { participants: readonly ParticipantView[] }
const { participants } = Astro.props
const compact = participants.length > 0 && participants.every(({ category }) => usesCompactParticipantDetails(category))
---
<div>
  <dialog
    aria-labelledby='event-modal-title'
    class:list={[
      'm-auto max-h-none w-[calc(100%-2rem)] overflow-visible border-0 bg-transparent p-0 text-foreground [--event-backdrop:0] backdrop:bg-background/80 backdrop:opacity-[var(--event-backdrop)]',
      compact ? 'max-w-prose' : 'max-w-3xl',
    ]}>
    <div data-modal-panel class='relative isolate flex max-h-[calc(100dvh-3rem-env(safe-area-inset-top)-env(safe-area-inset-bottom))] min-h-0 flex-col'>
      <button data-modal-close type='button' class='bg-background text-foreground absolute top-0 right-5 z-10 -translate-y-1/2 rounded-full px-3 py-2 text-sm transition-colors duration-200 hover:cursor-pointer hover:bg-accent hover:text-foreground motion-reduce:transition-none sm:right-8 focus-visible:outline-2 focus-visible:outline-offset-2'>Cerrar</button>
      <div data-modal-content class='flex min-h-0 flex-1 flex-col'></div>
    </div>
  </dialog>
  {participants.map(artist => <template data-event-template={artist.id}><ArtistDetail artist={artist} modal /></template>)}
</div>
<script>
  import { mountEventModal } from './event-modal'

  for (const root of document.querySelectorAll<HTMLElement>('[data-event-scope]')) {
    const scope = root.dataset.eventScope
    mountEventModal(root, { withDayFilter: scope !== 'market' && scope !== 'expo' })
  }
</script>
