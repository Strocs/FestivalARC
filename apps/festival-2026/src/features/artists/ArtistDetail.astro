---
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'
import { safeTicketUrl, type ParticipantView } from './categories'

interface Props { artist: ParticipantView, modal?: boolean }
const { artist, modal = false } = Astro.props
const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/**/*.{jpeg,jpg,png,webp,avif,gif}')
const image = artist.image
const loadImage = image ? images[image.url] : undefined
if (image && !loadImage) {
  throw new Error(`Artist image does not exist in src/assets: ${image.url}`)
}
const ticketUrl = safeTicketUrl(artist.ticketUrl)
---
{modal ? <div class='relative flex min-h-0 flex-1 flex-col'>
  <header data-modal-header class='shrink-0 p-5 pr-20 sm:p-8 sm:pr-24'>
    <h2 id='event-modal-title' tabindex='-1' class='text-arc-yellow break-words font-sans text-2xl/none font-black uppercase focus-visible:outline-2 sm:text-4xl/none'>{artist.name}</h2>
    <div data-modal-meta class='mt-4 space-y-1 text-sm'>
      {artist.disciplineName && <p>{artist.disciplineName}</p>}
      {artist.company && <p>{artist.company}</p>}
      <p>{artist.date.day} · {artist.date.time}</p>
    </div>
  </header>
  <div data-modal-details class='min-h-0 overflow-y-auto overscroll-contain px-5 pb-5 sm:px-8 sm:pb-8'>
    <div class:list={['grid items-start gap-5', image && 'md:grid-cols-[minmax(0,1fr)_minmax(0,2fr)]']}>
      {image && loadImage && <Image src={loadImage()} alt={image.alt} class='max-h-48 w-full rounded-lg object-contain md:max-h-72' />}
      {artist.description && <p class='min-w-0 whitespace-pre-line break-words text-sm/6'>{artist.description}</p>}
    </div>
  </div>
  {ticketUrl && <footer class='shrink-0 px-5 pb-5 sm:px-8 sm:pb-8'><a data-modal-ticket class='inline-block rounded-full bg-primary px-5 py-2 text-background underline focus-visible:outline-2 focus-visible:outline-offset-2' href={ticketUrl}>Entradas</a></footer>}
</div> : <div class:list={['grid items-start', image && 'md:grid-cols-[1fr_1fr]']}>
  {image && loadImage && <Image src={loadImage()} alt={image.alt} class='block h-auto w-full' />}
  <div class='min-w-0 p-4 sm:p-8'>
    <h1 class='font-display text-4xl/none uppercase sm:text-6xl/none'>{artist.name}</h1>
    {artist.company && <p class='mt-4'>{artist.company}</p>}
    {artist.disciplineName && <p class='mt-4'>{artist.disciplineName}</p>}
    <p class='mt-4'>{artist.date.day} · {artist.date.time}</p>
    {artist.description && <p class='mt-4 whitespace-pre-line text-sm/6'>{artist.description}</p>}
    {ticketUrl && <a class='mt-6 inline-block underline focus-visible:outline-2 focus-visible:outline-offset-2' href={ticketUrl}>Entradas</a>}
  </div>
</div>}
