---
import { Image } from 'astro:assets'
import ParticipantSocials from './ParticipantSocials.astro'
import type { ImageMetadata } from 'astro'
import { safeTicketUrl, type ParticipantView } from './categories'

interface Props { artist: ParticipantView, modal?: boolean }
const { artist, modal = false } = Astro.props
const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/**/*.{jpeg,jpg,png,webp,avif,gif}')
const image = artist.image
const loadImage = image ? images[image.url] : undefined
if (image && !loadImage) {
  throw new Error(`Artist image does not exist in src/assets: ${image.url}`)
}
const ticketUrl = safeTicketUrl(artist.ticketUrl)
const dateLabel = artist.date.month
  ? `${artist.date.day} de ${artist.date.month} · ${artist.date.time} hrs.`
  : `${artist.date.day} · ${artist.date.time}`
---
{modal ? <div class='relative flex min-h-0 flex-1 flex-col'>
  <header data-modal-header class='shrink-0 px-5 pt-5 pb-2 pr-20 sm:px-8 sm:pt-8 sm:pb-2 sm:pr-40'>
    <div class='flex min-w-0 flex-wrap items-end gap-x-6 gap-y-1'>
      <h2 id='event-modal-title' tabindex='-1' class='text-arc-yellow min-w-0 max-w-full break-words font-sans text-2xl/none font-black uppercase focus-visible:outline-2 sm:text-4xl/none'>{artist.name}</h2>
    </div>
  </header>
  <div data-modal-details class='min-h-0 overflow-y-auto overscroll-contain px-5 pb-5 sm:px-8 sm:pb-8'>
    <div class:list={['grid items-start gap-5', image && 'md:grid-cols-[minmax(0,1fr)_360px]']}>
      <div data-participant-copy class='min-w-0'>
        <div data-modal-meta class='text-sm'>
          <div class='space-y-1'>
            <div class='flex flex-wrap items-center gap-2'>
              {artist.disciplineName && <p>{artist.disciplineName}</p>}
              <ParticipantSocials artist={artist} />
            </div>
            {artist.company && <p>{artist.company}</p>}
          </div>
          <div class='mt-5 space-y-0.5'>
            <p><strong>{dateLabel}</strong></p>
            {artist.location && <p class='text-base/6 font-black text-white'>{artist.location}</p>}
          </div>
        </div>
        {artist.description && <p class='mt-5 whitespace-pre-line break-words text-sm/6'>{artist.description}</p>}
      </div>
      {image && loadImage && <Image src={loadImage()} alt={image.alt} quality={100} class='h-auto w-full rounded-lg' />}
    </div>
  </div>
  {ticketUrl && <footer class='shrink-0 px-5 pb-5 sm:px-8 sm:pb-8'><a data-modal-ticket class='inline-block rounded-full bg-primary px-5 py-2 text-background underline focus-visible:outline-2 focus-visible:outline-offset-2' href={ticketUrl}>Entradas</a></footer>}
</div> : <div>
  <div class='min-w-0 p-4 sm:p-8'>
    <div class='flex min-w-0 flex-wrap items-end gap-x-6 gap-y-1'>
      <h1 class='min-w-0 max-w-full break-words font-display text-4xl/none uppercase sm:text-6xl/none'>{artist.name}</h1>
    </div>
    <div class:list={['mt-2 grid items-start gap-5', image && 'md:grid-cols-[minmax(0,1fr)_360px]']}>
      <div class='min-w-0'>
        <div class='space-y-1 text-sm'>
          <div class='flex flex-wrap items-center gap-2'>
              {artist.disciplineName && <p>{artist.disciplineName}</p>}
              <ParticipantSocials artist={artist} />
            </div>
          {artist.company && <p>{artist.company}</p>}
        </div>
        <div class='mt-5 space-y-0.5'>
          <p><strong>{dateLabel}</strong></p>
          {artist.location && <p class='text-base/6 font-black text-white'>{artist.location}</p>}
        </div>
        {artist.description && <p class='mt-5 whitespace-pre-line break-words text-sm/6'>{artist.description}</p>}
      </div>
      {image && loadImage && <Image src={loadImage()} alt={image.alt} quality={100} class='h-auto w-full rounded-lg' />}
    </div>
    {ticketUrl && <a class='mt-6 inline-block underline focus-visible:outline-2 focus-visible:outline-offset-2' href={ticketUrl}>Entradas</a>}
  </div>
</div>}
