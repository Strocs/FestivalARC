<fieldset
  hidden
  data-day-filter
  class='bg-background text-foreground fixed bottom-[calc(1rem+env(safe-area-inset-bottom))] left-1/2 z-30 m-0 w-max max-w-[calc(100%-1rem)] -translate-x-1/2 rounded-full border border-foreground/30 p-2 shadow-lg'>
  <legend class='sr-only'>Filtrar artistas por día</legend>
  <div class='flex flex-wrap justify-center gap-1'>
    {(['Todos', 'Sábado 28', 'Domingo 29'] as const).map((label, index) => (
      <label class='relative cursor-pointer'>
        <input
          type='radio'
          name='poster-day'
          value={['all', 'saturday', 'sunday'][index]}
          checked={index === 0}
          class='peer sr-only' />
        <span class='flex min-h-11 items-center justify-center rounded-full px-4 py-2 text-sm font-bold peer-checked:bg-arc-yellow peer-checked:text-background peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-primary'>{label}</span>
      </label>
    ))}
  </div>
  <span data-day-count role='status' aria-live='polite' aria-atomic='true' class='sr-only'></span>
</fieldset>
