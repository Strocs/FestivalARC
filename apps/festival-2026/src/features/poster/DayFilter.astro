---
interface Props { presentation?: boolean; beforeBreadcrumb?: boolean }
const { presentation = false, beforeBreadcrumb = false } = Astro.props
const controlSize = 'h-11 rounded-full text-sm/5 font-bold'
---

<fieldset
  hidden
  data-day-filter
  data-poster-toolbar={presentation || undefined}
  class:list={[
    'mx-3 min-w-0 border bg-background text-foreground sm:mx-auto sm:w-fit',
    presentation ? 'rounded-full border-foreground/20 px-3 py-2 shadow-md md:px-4' : 'rounded-2xl border-foreground/25 p-2',
    beforeBreadcrumb ? 'mb-4' : 'mb-8 md:mb-12',
  ]}>
  <legend class='sr-only'>Filtrar artistas por día</legend>
  <div class='flex flex-col items-stretch gap-2 md:flex-row md:items-end md:gap-6'>
    <div class='flex flex-wrap justify-center gap-1'>
      {(['Todos', 'Sábado 28', 'Domingo 29'] as const).map((label, index) => (
        <label class='relative cursor-pointer'>
          <input
            type='radio'
            name='poster-day'
            value={['all', 'saturday', 'sunday'][index]}
            checked={index === 0}
            class='peer sr-only' />
          <span class:list={[
            controlSize,
            'flex items-center justify-center peer-checked:bg-arc-yellow peer-checked:text-background peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-primary md:px-4',
            presentation ? 'px-2.5 hover:bg-foreground/10 peer-checked:hover:bg-arc-yellow' : 'px-3',
          ]}>{label}</span>
        </label>
      ))}
    </div>
    {presentation && <div class='flex items-end justify-center gap-2 md:gap-3'>
      <label class='flex min-w-0 flex-col gap-0.5'>
        <span class='px-2.5 text-xs font-medium text-foreground/80'>Ordenar por</span>
        <select data-poster-sort class:list={[controlSize, 'w-28 max-w-full cursor-pointer border border-foreground/25 bg-background px-3 py-0 text-foreground hover:border-foreground/50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary']}>
          <option value=''>Afiche</option>
          <option value='time'>Horario</option>
          <option value='location'>Escenario</option>
        </select>
      </label>
      <button type='button' data-poster-simple-toggle aria-pressed='false' class:list={[controlSize, 'flex cursor-pointer items-center justify-center gap-2 border border-foreground/25 px-3 opacity-75 hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary aria-pressed:border-arc-yellow aria-pressed:bg-arc-yellow aria-pressed:text-background aria-pressed:opacity-100']}>
        <svg aria-hidden='true' class='size-4 shrink-0' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round'><path d='M9 6h11M9 12h11M9 18h11M4 6h.01M4 12h.01M4 18h.01' /></svg>
        Vista simple
      </button>
    </div>}
  </div>
  <span data-day-count role='status' aria-live='polite' aria-atomic='true' class='sr-only'></span>
</fieldset>

<style>
  [data-poster-toolbar] {
    position: sticky;
    top: var(--poster-header-height, auto);
    z-index: 30;
  }
  [data-poster-toolbar-concealed]:not(:focus-within) {
    opacity: 0;
    translate: 0 -100%;
    pointer-events: none;
  }
  /* The picker can also be opened programmatically without moving focus. */
  [data-poster-toolbar-concealed]:has([data-poster-sort]:open) {
    opacity: 1;
    translate: none;
    pointer-events: auto;
  }
  @media (prefers-reduced-motion: no-preference) {
    [data-poster-toolbar]:not(:focus-within) {
      transition: translate 200ms ease, opacity 200ms ease;
    }
  }

  /* The native select remains usable without customizable picker support. */
  @supports (appearance: base-select) and selector(::picker(select)) {
    [data-poster-sort],
    [data-poster-sort]::picker(select) {
      appearance: base-select;
    }
    [data-poster-sort] {
      align-items: center;
    }
    [data-poster-sort]::picker-icon {
      color: var(--color-arc-yellow);
    }
    [data-poster-sort]::picker(select) {
      margin-block: .375rem;
      padding: .25rem;
      border: 1px solid color-mix(in oklab, var(--color-foreground) 30%, transparent);
      border-radius: var(--radius-3xl);
      background: var(--color-background);
      color: var(--color-foreground);
      box-shadow: 0 .5rem 1.25rem rgb(0 0 0 / .35);
    }
    option {
      min-height: 2.75rem;
      padding: .5rem;
      border-radius: calc(infinity * 1px);
      font-size: .875rem;
      font-weight: 700;
    }
    option:checked {
      background: var(--color-arc-yellow);
      color: var(--color-background);
    }
    option:is(:hover, :focus-visible) {
      outline: 2px solid var(--color-primary);
      outline-offset: -2px;
    }
  }
  @supports (appearance: base-select) and selector(::picker(select)) and (transition-behavior: allow-discrete) and (overlay: auto) {
    @media (prefers-reduced-motion: no-preference) {
      [data-poster-sort]::picker(select) {
        opacity: 0;
        transform: translateY(-.25rem);
        /* Keep the picker painted in the top layer until the exit completes. */
        transition: opacity 160ms ease-out, transform 160ms ease-out,
          display 160ms allow-discrete, overlay 160ms allow-discrete;
      }
      [data-poster-sort]:open::picker(select) {
        opacity: 1;
        transform: none;
      }
      @starting-style {
        [data-poster-sort]:open::picker(select) {
          opacity: 0;
          transform: translateY(-.25rem);
        }
      }
    }
  }
</style>
