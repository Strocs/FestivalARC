---
import PosterInformation from './PosterInformation.astro'
import PosterArrow from './PosterArrow.astro'
import type { SlotRect } from './poster-grid'
import type { PosterRange } from './poster'

type Placement = Partial<Record<PosterRange, SlotRect>>
interface Props {
  placement: Placement
  informationId?: string
}
const { placement, informationId } = Astro.props
const links = [
  { label: 'Instagram', href: 'https://www.instagram.com/festival_arc' },
  { label: 'Facebook', href: 'https://www.facebook.com/FestivalARC' },
  { label: 'X', href: 'https://x.com/FestivalARC' },
]
---

<PosterInformation {...placement} informationId={informationId}>
  <div class='flex h-full min-h-0 flex-col justify-center'>
    {
      links.map(({ label, href }) => (
        <a
          href={href}
          target='_blank'
          rel='noopener noreferrer'
          aria-label={label}
          class='group/social text-foreground hover:text-arc-rose flex min-h-0 items-center justify-start gap-2 px-0 md:px-6 py-2 font-black transition-colors duration-300'>
          <span class='wrap-anywhere min-w-0 text-[length:clamp(1rem,calc(0.5rem+7cqw),3rem)] uppercase leading-[.94] tracking-[-.04em]'>
            {label}
          </span>
          <PosterArrow class='group-hover/social:-rotate-45' />
        </a>
      ))
    }
  </div>
</PosterInformation>
