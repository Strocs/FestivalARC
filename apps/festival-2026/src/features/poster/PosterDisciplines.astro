---
import PosterInformation from './PosterInformation.astro'
import PosterArrow from './PosterArrow.astro'
import { categories } from '../artists/categories'
import { measureArtistName } from './artist-name'
import { categoryLink } from '../../utils/publication'
import type { SlotRect } from './poster-grid'
import type { PosterRange } from './poster'

type Props = Partial<Record<PosterRange, SlotRect>> & { informationId?: string }
const { mobile, tablet, desktop, informationId } = Astro.props
---

<PosterInformation {mobile} {tablet} {desktop} {informationId}>
  <aside
    class='flex min-h-0 items-center py-3 font-black'
    aria-label='Categorías'>
    <!-- This container's content box excludes padding. Its cqw is shared by
         the label fit and PosterArrow, not the outer poster's --unit. -->
    <ul
      class='@container m-0 w-full min-w-0 list-none space-y-2 px-0 py-4 uppercase leading-[1.12] md:px-6'>
      {
        categories.map((category) => (
          <li class={'text-foreground'}>
            <a
              href={categoryLink(category.path)}
              style={`--category-fit:${0.9 / measureArtistName(category.name)}`}
              class='group/category hover:text-arc-rose focus-visible:text-arc-rose flex items-center gap-3 transition-colors duration-300 ease-out focus-visible:outline-2 focus-visible:outline-offset-2 motion-reduce:transition-none'>
              <span class='wrap-break-word md:wrap-normal min-w-0 flex-1 text-[length:min(3rem,calc((100cqw-clamp(2rem,12cqw,5rem)-0.75rem)*var(--category-fit)))] md:whitespace-nowrap md:text-[length:calc((100cqw-clamp(2rem,12cqw,5rem)-0.75rem)*var(--category-fit))]'>
                {category.name}
              </span>
              <PosterArrow class='ease-out group-hover/category:-rotate-45 group-focus-visible/category:-rotate-45 motion-reduce:transition-none' />
            </a>
          </li>
        ))
      }
    </ul>
  </aside>
</PosterInformation>
