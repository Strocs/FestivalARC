---
interface Props { kind: 'program' | 'disciplines' }
const { kind } = Astro.props
const disciplines = ['Música', 'Artesanía', 'Diseño', 'Ilustración', 'Literatura', 'Artes escénicas', 'Artes visuales']
---
{kind === 'program' ? (
  <aside class='min-h-0 text-(--poster-text) font-black flex items-center justify-between gap-3 p-3' aria-label='Programación'>
    <p class='min-w-0 m-0 wrap-anywhere text-[length:clamp(1.5rem,calc(0.5rem+9cqw),4.25rem)] leading-[.94] tracking-[-.04em]'>PROGRA<br />MACIÓN</p>
    <svg class='flex-none w-[clamp(2rem,12cqw,5rem)] h-auto fill-current' viewBox='0 0 100 100' aria-hidden='true' focusable='false'>
      <path d='M8 42H65L42 18H64L94 50 64 82H42L65 58H8Z' />
    </svg>
  </aside>
) : (
  <aside class='min-h-0 text-(--poster-text) font-black flex items-center py-3' aria-label='Disciplinas'>
    <ul class='m-0 p-0 min-w-0 list-none wrap-anywhere text-[length:clamp(1rem,calc(0.5rem+5cqw),3.75rem)] leading-[1.12] tracking-[-.04em] uppercase'>{disciplines.map(discipline => <li>{discipline}</li>)}</ul>
  </aside>
)}
