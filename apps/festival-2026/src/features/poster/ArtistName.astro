---
import { canOpenParticipantDetails, usesCompactParticipantDetails, type ParticipantView } from '../artists/categories'
import { publicPath } from '../../utils/publication'
import { getArtistCompositions, getArtistFitRanges } from './artist-name'

interface Props {
  artist: ParticipantView
  interactive?: boolean
}

const { artist, interactive: allowInteraction = true } = Astro.props
const compactDetails = usesCompactParticipantDetails(artist.category)
const interactive = allowInteraction && canOpenParticipantDetails(artist)
const Wrapper = interactive ? 'a' : 'div'
const words = artist.name.trim().split(/\s+/)
const compositions = getArtistCompositions(artist.name)
const ranges = getArtistFitRanges(compositions)
// Encode the identifier so generated selectors contain no unescaped input.
const labelClass = `artist-fit-${Array.from(artist.id, (character) => character.codePointAt(0)!.toString(16)).join('-')}`
const selector = `.${labelClass}`
const rules = ranges
  .map(({ minRatio, index }, rangeIndex) => {
    const option = compositions[index]
    const font = `min(calc(100cqw / ${option.width}), calc(100cqh / ${option.lines.length}))`
    const cuts = option.breaks
      .map(
        (cut) =>
          `${selector} [data-gap="${cut}"]{display:none}${selector} [data-break="${cut}"]{display:initial}`,
      )
      .join('')
    const css = `${selector}{font-size:${font}}${selector} [data-gap]{display:inline}${selector} [data-break]{display:none}${cuts}`
    return rangeIndex === 0
      ? css
      : `@container artist-name (min-aspect-ratio:${minRatio}){${css}}`
  })
  .join('\n')
---

<article
  class='bg-background group relative min-h-0 w-full min-w-0'
  aria-label={artist.name}>
  <Wrapper
    href={interactive ? publicPath(artist.canonicalPath) : undefined}
    data-artist-card-link
    data-event-trigger={interactive ? '' : undefined}
    data-event-id={interactive ? artist.id : undefined}
    aria-label={interactive ? (compactDetails ? `Ver más sobre ${artist.name}` : artist.name) : undefined}
    class='focus-visible:outline-primary absolute inset-0 size-full appearance-none border-0 bg-transparent p-0 focus-visible:outline-2 focus-visible:outline-offset-[-2px]'>
    <span
      data-artist-content
      class:list={[
        'absolute inset-x-6 grid grid-cols-1 grid-rows-[minmax(0,1fr)_auto] [container-type:size]',
        interactive ? 'top-[min(0.75rem,8%)] bottom-[min(1.5rem,15%)]' : 'inset-y-[min(1.5rem,15%)]',
      ]}>
      <span
        data-artist-surface
        class='bg-background motion-reduce:translate-none relative col-start-1 row-start-1 min-h-0 rounded-lg transition-transform duration-300 motion-safe:group-hover:-translate-y-0.5 motion-reduce:transition-none group-data-[poster-simple]/poster:absolute group-data-[poster-simple]/poster:inset-x-0 group-data-[poster-simple]/poster:top-0 group-data-[poster-simple]/poster:bottom-2.5 group-data-[poster-simple]/poster:col-auto group-data-[poster-simple]/poster:row-auto group-data-[poster-simple]/poster:rounded-xl'
      ></span>
      <span
        data-artist-name-box
        class:list={[
          'motion-reduce:translate-none relative col-start-1 row-start-1 mx-3 flex min-h-0 items-center justify-center transition-transform duration-300 [container-name:artist-name] [container-type:size] motion-safe:group-hover:-translate-y-0.5 motion-reduce:transition-none',
          interactive ? 'pt-1 pb-0.5' : 'py-[min(1rem,10cqh)]',
        ]}>
        <span
          data-artist-name
          class:list={[
            'text-arc-yellow block shrink-0 whitespace-nowrap text-center font-sans font-black uppercase leading-none',
            labelClass,
          ]}
          >{
            words.map((word, index) => (
              <>
                {index > 0 && (
                  <>
                    <span data-gap={index}> </span>
                    <br data-break={index} />
                  </>
                )}
                {word}
              </>
            ))
          }</span
        >
      </span>
      {interactive && <span
        data-artist-meta
        class='relative col-start-1 row-start-2 flex min-w-0 flex-col items-center gap-px text-center text-xs/[1] text-foreground group-data-[poster-simple]/poster:text-white'>
        {!compactDetails && (artist.date || artist.location) && <span
          class='flex min-w-0 flex-col items-center gap-px motion-safe:transition-transform motion-safe:duration-300 motion-safe:group-hover:-translate-y-0.5'>
          {artist.date && <time class='font-bold'>{artist.date.day} - {artist.date.time}hrs</time>}
          {artist.location && <span data-artist-location class='text-pretty font-medium'>{artist.location}</span>}
        </span>}
        <!-- Visual cue for the whole-tile link, not a nested control. -->
        <span
          data-artist-view
          aria-hidden='true'
          class='bg-primary text-background motion-reduce:translate-none mt-1 rounded-full px-3 py-0.5 leading-4 transition-transform duration-300 motion-safe:group-hover:translate-y-1 motion-reduce:transition-none'
          >Ver <strong>más</strong></span
        >
      </span>}
    </span>
  </Wrapper>
  <style is:inline set:html={rules}></style>
</article>

<style is:global>
  @media (width < 48rem) {
    /* Only the synchronous design sample uses the original absolute layout. */
    [data-poster-grid]:not([data-poster-sampling-tracks]) [data-artist-card-link] {
      position: relative;
      display: block;
      height: auto;
    }
    [data-poster-grid]:not([data-poster-sampling-tracks]) [data-artist-content] {
      position: relative;
      inset: auto;
      margin-inline: min(24px, 10%);
      padding-block: var(--poster-name-top, 12px) var(--poster-name-bottom, 12px);
      container-type: normal;
      grid-template-rows: var(--poster-name-row, clamp(36px, 15cqw, 58px)) auto;
    }
    [data-poster-grid]:not([data-poster-sampling-tracks]) [data-artist-name-box] {
      justify-self: center;
      width: var(--poster-name-width, stretch);
      padding: var(--poster-name-padding, 4px 0 2px);
    }
    [data-poster-grid]:not([data-poster-sampling-tracks]) [data-artist-meta] {
      overflow-wrap: anywhere;
    }
    [data-poster-grid][data-poster-sampling-tracks] [data-artist-meta] {
      text-size-adjust: none;
      -webkit-text-size-adjust: none;
    }
    [data-poster-grid][data-poster-sampling-tracks] :is([data-artist-meta], [data-artist-meta] *) {
      font-size: 12px !important;
      line-height: 12px !important;
      letter-spacing: normal !important;
      word-spacing: normal !important;
    }
    [data-poster-grid][data-poster-sampling-tracks] [data-artist-view],
    [data-poster-grid][data-poster-sampling-tracks] [data-artist-view] strong {
      line-height: 16px !important;
    }
  }
</style>
