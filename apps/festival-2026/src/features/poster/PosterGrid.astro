---
import ArtistName from './ArtistName.astro'
import DayFilter from './DayFilter.astro'
import EventModal from '../artists/EventModal.astro'
import CategoryTitle from './CategoryTitle.astro'
import { createCategoryTitle } from './category-title'
import PosterDefinitions from './PosterDefinitions.astro'
import PosterDisciplines from './PosterDisciplines.astro'
import PosterIntro from './PosterIntro.astro'
import PosterPattern from './PosterPattern.astro'
import PosterPlace from './PosterPlace.astro'
import PosterSocials from './PosterSocials.astro'
import { heroParticipants, type CategoryView } from '../artists/categories'
import { slotSize, type PosterRange } from './poster'
import type { SlotRect } from './poster-grid'
import { createPosterFilterPlans } from './poster-filter-layout'
import {
  posterIntroPlacement, posterTitleExtensionPlacement,
  posterDisciplinesPlacement, posterPlacePlacement,
  posterSocialsPlacement, homeInformation,
} from './poster-layout'

interface Props { category?: CategoryView }
const { category } = Astro.props
const lineup = category?.participants ?? heroParticipants
const filterPlans = createPosterFilterPlans({
  scope: category ? 'category' : 'home',
  participants: lineup.map(({ id, date }) => ({ id, day: date.day })),
  information: category ? createCategoryTitle(category.name).information : homeInformation,
})
const serializedPlans = JSON.stringify(filterPlans).replace(/</g, '\\u003c')
const ranges = ['mobile', 'tablet', 'desktop'] as const
const { layouts } = filterPlans.plans.all
type Positions = Record<PosterRange, SlotRect | undefined>
const positions = (values: Positions, display: 'block' | 'grid' = 'block') =>
  ranges
    .map((range) => {
      const value = values[range]
      return `--${range}-display:${value ? display : 'none'};--${range}-column:${value?.column ?? 0};--${range}-row:${value?.row ?? 0};--${range}-width:${value?.width ?? 1};--${range}-height:${value?.height ?? 1}`
    })
    .join(';')
const artistPositions = (id: string): Positions => ({
  mobile: layouts.mobile.artists.find((artist) => artist.id === id),
  tablet: layouts.tablet.artists.find((artist) => artist.id === id),
  desktop: layouts.desktop.artists.find((artist) => artist.id === id),
})
const motifSlots = filterPlans.plans.all.motifs.map(({ index, variant, positions: endpoints }) => ({
  index,
  motif: variant,
  style: positions({ mobile: endpoints.mobile, tablet: endpoints.tablet, desktop: endpoints.desktop }),
}))
const gridStyle =
  `--slot-width:${slotSize.width};--slot-height:${slotSize.height};` +
  ranges.map((range) => `--${range}-rows:${layouts[range].rows}`).join(';')
const slotClasses =
  'min-w-0 [display:var(--mobile-display)] [grid-column:calc(var(--mobile-column)+1)/span_var(--mobile-width)] [grid-row:calc(var(--mobile-row)+1)/span_var(--mobile-height)] md:[display:var(--tablet-display)] md:[grid-column:calc(var(--tablet-column)+1)/span_var(--tablet-width)] md:[grid-row:calc(var(--tablet-row)+1)/span_var(--tablet-height)] xl:[display:var(--desktop-display)] xl:[grid-column:calc(var(--desktop-column)+1)/span_var(--desktop-width)] xl:[grid-row:calc(var(--desktop-row)+1)/span_var(--desktop-height)]'
---

<main
  class='flex-1 px-0 py-8 md:px-8 md:py-12 xl:px-[8.333333vw] xl:py-20'
  aria-labelledby='page-title'
  data-event-scope={category?.key ?? 'home'}>
  <div class='@container mx-auto w-full max-w-[1600px]'>
    <PosterDefinitions />
    <section
      data-poster-grid
      class='relative isolate grid grid-cols-[repeat(var(--columns),minmax(0,1fr))] grid-rows-[repeat(var(--rows),auto)] [--columns:8] [--poster-text:#d5d5d5] [--rows:var(--mobile-rows)] [--unit:calc(100cqw/(var(--columns)*var(--slot-width)))] md:grid-rows-[repeat(var(--rows),minmax(calc(var(--slot-height)*var(--unit)),auto))] md:[--columns:6] md:[--rows:var(--tablet-rows)] xl:[--columns:10] xl:[--rows:var(--desktop-rows)]'
      style={gridStyle}
      aria-label={category ? `${category.name}: artistas y obras` : 'Festival ARC: artistas y obras'}>
      {
        motifSlots.map((tile) => (
          <div
            class:list={[slotClasses, 'pattern-slot aspect-[160/152] min-h-0 md:aspect-auto']}
            style={tile.style}
            data-poster-motif={tile.motif}
            data-poster-motif-index={tile.index}
            aria-hidden='true'>
            <PosterPattern motif={tile.motif} />
          </div>
        ))
      }
      {category ? <CategoryTitle name={category.name} /> : <>
        <PosterIntro {...posterIntroPlacement} titleExtension={posterTitleExtensionPlacement} informationId='intro' titleExtensionId='title-extension' />
        <PosterDisciplines {...posterDisciplinesPlacement} informationId='disciplines' />
      </>}
      {
        lineup.map((artist) => (
          <div
            class:list={[slotClasses, 'z-2 relative min-h-[calc(3*var(--slot-height)*var(--unit))] md:min-h-0']}
            style={positions(artistPositions(artist.id), 'grid')}
            data-poster-artist={artist.id}>
            <ArtistName artist={artist} />
          </div>
        ))
      }
      {!category && <>
        <PosterPlace {...posterPlacePlacement} informationId='place' />
        <PosterSocials {...posterSocialsPlacement} informationIds={{ instagram: 'instagram', facebook: 'facebook', twitter: 'twitter' }} />
      </>}
    </section>
  </div>
  <script is:inline type='application/json' data-poster-plans set:html={serializedPlans} />
  {filterPlans.available && <DayFilter />}
  <EventModal participants={lineup} />
</main>
