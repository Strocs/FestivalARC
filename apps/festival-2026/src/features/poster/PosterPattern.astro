---
import type { PosterMotif } from './poster'
interface Props { motif: PosterMotif }
const { motif } = Astro.props
---
<!-- Bleed shared edges without changing grid tracks or disabling antialiasing. -->
<svg class='block relative left-[-0.5px] top-[-0.5px] w-[calc(100%+1px)] h-[calc(100%+1px)]' viewBox='0 0 100 100' preserveAspectRatio='none' aria-hidden='true' focusable='false'>
  <use href={`#${motif}`} />
</svg>
