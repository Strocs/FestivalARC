---
import { Font } from 'astro:assets'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import { appBase, publicPath } from '../utils/publication'
import '../styles/global.css'

interface Props {
  title?: string
  description?: string
}

const {
  title = 'Festival ARC 2026 | El arte de habitar la ciudad',
  description = 'Descubre el Festival ARC 2026 este 28 y 29 de noviembre. Música, arte, diseño y cultura regional en una celebración gratuita en la Plaza de Armas de La Serena.',
} = Astro.props
const path =
  Astro.url.pathname === appBase
    ? '/'
    : Astro.url.pathname.replace(`${appBase}/`, '/')
const siteUrl = 'https://festivalarc.com'
const canonical = new URL(publicPath(path), siteUrl)
  .toString()
  .replace(/\/$/, '')
const socialImage = new URL(publicPath('/og-image.jpg'), siteUrl).toString()
---

<!doctype html>
<html lang='es' class='min-h-full'>
  <head>
    <meta charset='utf-8' />
    <meta name='viewport' content='width=device-width' />
    <meta name='description' content={description} />
    <meta property='og:type' content='website' />
    <meta property='og:locale' content='es_CL' />
    <meta property='og:title' content={title} />
    <meta property='og:description' content={description} />
    <meta property='og:url' content={canonical} />
    <meta property='og:image' content={socialImage} />
    <meta property='og:image:width' content='1200' />
    <meta property='og:image:height' content='630' />
    <meta property='og:image:alt' content={title} />
    <meta name='twitter:card' content='summary_large_image' />
    <meta name='twitter:title' content={title} />
    <meta name='twitter:description' content={description} />
    <meta name='twitter:image' content={socialImage} />
    <meta name='twitter:image:alt' content={title} />
    <link
      rel='icon'
      type='image/png'
      sizes='512x512'
      href={publicPath('/favicon.png')}
    />
    <link rel='canonical' href={canonical} />
    <Font cssVariable='--font-poppins' />
    <Font cssVariable='--font-anton' />
    <title>{title}</title>
  </head>
  <!-- Low-specificity defaults let existing element utilities retain their overrides. -->
  <body
    class='bg-background text-foreground [:where(&_a:focus-visible)]:outline-offset-3 m-0 flex h-full min-h-svh flex-col font-sans [:where(&_a:focus-visible)]:[outline:3px_solid_var(--color-primary)] [:where(&_h1,&_h2)]:font-normal [:where(&_h1,&_h2)]:[font-synthesis:none]'>
    <Header />
    <slot />
    <Footer />
  </body>
</html>
