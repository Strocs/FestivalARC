---
import { Image } from 'astro:assets'
import { Icon } from 'astro-icon/components'
import Layout from '../layouts/Layout.astro'
import { call } from '../data/calls'
import logoHero from '../assets/LOGO_HERO.jpg'
---
<Layout>
  <main class='calls-body flex flex-1 flex-col px-5 py-8 font-sans text-foreground sm:px-8 sm:py-12 lg:px-12 lg:py-16' aria-labelledby='page-title'>
    <section class='hero mx-auto flex w-full max-w-screen-2xl flex-col items-center text-center' aria-labelledby='page-title'>
      <h1 id='page-title' class='sr-only'>Convocatoria Festival ARC 2026</h1>
      <div class='hero-art' aria-hidden='true'><Image src={logoHero} alt='' class='hero-image' loading='eager' /></div>
      <p class='deadline'>
        <span class='deadline-prefix'>{call.deadline.prefix}</span>
        <span class='deadline-accent'>{call.deadline.start}</span>
        <span>{call.deadline.connector}</span>
        <span class='deadline-accent'>{call.deadline.end}</span>
        <span>{call.deadline.suffix}</span>
        <span class='deadline-accent'>{call.deadline.month}</span>
      </p>
      <hr class='hero-separator' aria-hidden='true' />
    </section>

    <section class='applications mx-auto w-full max-w-screen-2xl' aria-labelledby='lines-title'>
      <h2 id='lines-title'>Selecciona tu línea de postulación</h2>
      <div class='category-grid'>
        {call.categories.map((category) => <article class='category'>
          <h3>{category.title}</h3>
          <ul>
            {category.disciplines.map((discipline) => <li>
              <a class='group' href={discipline.url} target='_blank' rel='noopener noreferrer'>{discipline.name}<Icon name='lucide:arrow-right' aria-hidden='true' class='ml-[0.15em] size-[0.85em] shrink-0 transition-transform duration-200 ease-in-out motion-reduce:transform-none motion-reduce:transition-none group-hover:-rotate-45 group-focus-visible:-rotate-45' /></a>
            </li>)}
          </ul>
        </article>)}
      </div>
    </section>

    <button type='button' class='bases rounded-2xl border-3 lg:border-4' disabled>Descarga las bases</button>
  </main>
</Layout>

<style>
  .calls-body { overflow: hidden; }
  .hero { padding-bottom: clamp(.75rem, 2vw, 1.5rem); }
  .hero-art { width: min(100%, 72rem); aspect-ratio: 10 / 3; overflow: hidden; position: relative; }
  .hero-image { display: block; width: 100%; height: 100%; object-fit: cover; object-position: center; }
  .deadline { display: flex; flex-wrap: wrap; justify-content: center; gap: .2em .35em; margin-top: .5rem; font-size: clamp(1.25rem, 3vw, 2rem); font-weight: 800; line-height: .9; text-transform: uppercase; letter-spacing: -.02em; }
  .deadline-accent { color: var(--color-primary); }
  h3 { color: var(--color-foreground); }
  .category a:hover, .category a:focus-visible { color: var(--color-accent); }
  .deadline-prefix { color: var(--color-foreground); }
  .hero-separator { width: min(12rem, 36vw); margin: clamp(1rem, 2vw, 1.5rem) auto 0; border: 0; border-top: 2px solid var(--color-primary); }
  .applications { padding: clamp(2.25rem, 5vw, 4.5rem) 0; }
  h2 { color: var(--color-foreground); font-size: clamp(1.05rem, 2vw, 1.5rem); font-weight: 400; letter-spacing: -.03em; line-height: 1.1; text-align: center; }
  .category-grid { display: grid; gap: clamp(3rem, 7vw, 6rem); grid-template-columns: repeat(2, minmax(0, 1fr)); margin: clamp(2.5rem, 5vw, 4rem) auto 0; max-width: 64rem; }
  .category { display: flex; flex-direction: column; align-items: center; }
  h3 { font-size: clamp(1.25rem, 2.5vw, 2.25rem); font-weight: 900; line-height: .95; max-width: 14ch; text-align: center; text-transform: uppercase; }
  ul { width: fit-content; margin-top: 2rem; }
  li { display: flex; justify-content: center; padding: .45rem 0; text-align: center; }
  li a { align-items: center; color: var(--color-foreground); display: inline-flex; flex-wrap: wrap; justify-content: center; font-size: clamp(1.35rem, 3.4vw, 3rem); font-weight: 900; letter-spacing: -.06em; line-height: 1; text-align: center; text-transform: uppercase; }
  .bases { align-self: center; color: var(--color-primary); font-size: clamp(1rem, 2vw, 1.3rem); font-weight: 900; padding: 1rem 1.25rem; text-transform: uppercase; transition: background-color .2s, color .2s; }
  .bases:disabled { cursor: not-allowed; opacity: .82; }
  .bases:focus-visible, a:focus-visible { outline: 3px solid var(--color-accent); outline-offset: 4px; }
  @media (max-width: 640px) { .category-grid { grid-template-columns: 1fr; gap: 3rem; } }
  @media (prefers-reduced-motion: reduce) { .bases { transition: none; } }
</style>
