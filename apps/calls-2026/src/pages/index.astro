---
import { Image } from 'astro:assets'
import { Icon } from 'astro-icon/components'
import Layout from '../layouts/Layout.astro'
import { call } from '../data/calls'
import logoHero from '../assets/LOGO_HERO.jpg'
---
<Layout>
  <main class='flex flex-1 flex-col overflow-hidden px-5 py-8 font-sans text-foreground sm:px-8 sm:py-12 lg:px-12 lg:py-16' aria-labelledby='page-title'>
    <section class='mx-auto flex w-full max-w-screen-2xl flex-col items-center pb-[clamp(.75rem,2vw,1.5rem)] text-center' aria-labelledby='page-title'>
      <h1 id='page-title' class='sr-only'>Convocatoria Festival ARC 2026</h1>
      <div class='relative aspect-[10/3] w-full max-w-[72rem] overflow-hidden' aria-hidden='true'><Image src={logoHero} alt='' class='block size-full object-cover object-center' loading='eager' /></div>
      <p class='flex flex-wrap items-center justify-center gap-x-2 leading-none text-[clamp(1.25rem,3vw,1.8rem)] tracking-tighter'>
        <span class='uppercase font-bold text-[110%] text-foreground'>{call.deadline.prefix}</span>
        <span class='text-primary'>{call.deadline.start}</span>
        <span>{call.deadline.connector}</span>
        <span class='text-primary'>{call.deadline.end}</span>
        <span>{call.deadline.suffix}</span>
        <span class='capitalize text-primary'>{call.deadline.month}</span>
      </p>
      <hr class='mx-auto mt-[clamp(1rem,2vw,1.5rem)] w-[min(12rem,36vw)] border-0 border-t-2 border-primary' aria-hidden='true' />
    </section>

    <section class='mx-auto w-full container py-[clamp(2.25rem,5vw,4.5rem)]' aria-labelledby='lines-title'>
      <h2 id='lines-title' class='text-center text-[clamp(1.05rem,2vw,1.5rem)] leading-[1.1] tracking-[-.03em] text-foreground'>Selecciona tu línea de postulación</h2>
      <div class='mx-auto mt-[clamp(2.5rem,5vw,4rem)] grid max-w-6xl grid-cols-2 gap-[clamp(3rem,7vw,6rem)] max-[640px]:grid-cols-1 max-[640px]:gap-12'>
        {call.categories.map((category) => <article class='flex flex-col items-center'>
          <h3 class='text-primary font-extralight text-center text-[clamp(1.25rem,2.25vw,2rem)] leading-[.95]'>{category.title}</h3>
          <ul class='mt-8 w-fit'>
            {category.disciplines.map((discipline) => <li class='flex justify-center py-2 text-center'>
              <a class='group font-extrabold inline-flex items-center justify-center text-center text-[clamp(1.35rem,3.4vw,2.6rem)] leading-none flex-nowrap text-nowrap text-foreground uppercase hover:text-accent focus-visible:text-accent focus-visible:outline-[3px] focus-visible:outline-solid focus-visible:outline-offset-4 focus-visible:outline-accent' href={discipline.url} target='_blank' rel='noopener noreferrer'>{discipline.name}<Icon name='lucide:arrow-right' aria-hidden='true' class='ml-[0.15em] size-[0.85em] shrink-0 transition-transform duration-200 ease-in-out motion-reduce:transform-none motion-reduce:transition-none group-hover:-rotate-45 group-focus-visible:-rotate-45' /></a>
            </li>)}
          </ul>
        </article>)}
      </div>
    </section>

    <hr class='mx-auto mt-0 mb-[clamp(1rem,2vw,1.5rem)] w-[min(12rem,36vw)] border-0 border-t-2 border-primary' aria-hidden='true' />
    <a class='self-center rounded-2xl border-3 border-primary bg-transparent px-5 py-4 text-[clamp(1rem,2vw,1.3rem)] font-semibold text-primary uppercase transition-[background-color,border-color,color] duration-200 ease-[ease] hover:border-accent hover:bg-accent hover:text-foreground focus-visible:outline-[3px] focus-visible:outline-solid focus-visible:outline-offset-4 focus-visible:outline-accent motion-reduce:transition-none disabled:cursor-not-allowed disabled:opacity-[.82] lg:border-4' href='https://drive.google.com/file/d/1yrXH3Zgdu2ItJ0KRIWrs0vCnUWelpjGk/view?usp=sharing' target='_blank' rel='noopener noreferrer'>Descarga las bases</a>
  </main>
</Layout>
