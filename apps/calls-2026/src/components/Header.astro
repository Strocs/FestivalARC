---
import { Image } from 'astro:assets'
import logo from '../assets/logo.png'
import PreviousEditions from './PreviousEditions.astro'
import { publicPath } from '../utils/publication'
---
<header class='z-10 border-b border-primary/10 px-5 py-3 sm:px-8 lg:px-12'>
  <div class='mx-auto flex w-full max-w-screen-2xl items-center justify-between gap-4'>
    <div class='flex items-center gap-3 sm:gap-4'>
      <a
        href={publicPath('/')}
        aria-label='Ir al inicio'
        class='block shrink-0 rounded focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary'
      >
        <Image
          src={logo}
          alt='Logotipo del Festival ARC'
          class='block h-auto w-24 sm:w-28'
          loading='eager'
        />
      </a>
      <div class='text-xs leading-tight text-foreground sm:text-sm'>
        <p class='font-bold'>28 y 29 de Noviembre</p>
        <p>Plaza de Armas, La Serena</p>
      </div>
    </div>
    <PreviousEditions />
  </div>
</header>
