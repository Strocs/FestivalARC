---
import { publicationConfig } from '../../../../editions.config'
import { previousEditionTargets } from './previousEditions'

const editions = previousEditionTargets(publicationConfig)
---
<nav
  class='previous-editions z-10 flex justify-center py-4 [&_summary]:list-none [&_summary::-webkit-details-marker]:hidden'
  aria-label='Ultimas ediciones'
>
  <details class='relative'>
    <summary
      class='group capitalize flex cursor-pointer items-center gap-2 px-3 py-1 text-sm leading-tight text-foreground transition-colors hover:text-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary'
    >
    <span>últimas ediciones</span>
      <span
        class='h-0 w-0 border-x-4 border-x-transparent border-t-[6px] border-t-current transition-transform'
        aria-hidden='true'
      ></span>
    </summary>
    <ul
      class='absolute left-1/2 mt-1 min-w-full -translate-x-1/2 rounded bg-background p-1 text-center text-foreground'
    >
      {editions.map((edition) => (
        <li>
          <a
            href={edition.href}
            class='block whitespace-nowrap px-3 py-1.5 text-sm transition-colors hover:text-primary focus-visible:text-primary focus-visible:outline-none'
          >
            {edition.label}
          </a>
        </li>
      ))}
    </ul>
  </details>
</nav>
