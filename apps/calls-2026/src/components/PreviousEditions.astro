---
import { publicationConfig } from '../../../../editions.config'
import { previousEditionTargets } from './previousEditions'

const editions = previousEditionTargets(publicationConfig)
---
<nav
  class='previous-editions z-10 flex justify-center py-4'
  aria-label='Ultimas ediciones'
>
  <div class='editions-dropdown group relative'>
    <div
      class='editions-trigger flex cursor-pointer items-center gap-2 px-3 py-1 text-sm leading-tight capitalize text-foreground transition-colors hover:text-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary'
      tabindex='0'
    >
      <span>últimas ediciones</span>
      <span
        class='h-0 w-0 border-x-4 border-x-transparent border-t-[6px] border-t-current transition-transform group-hover:rotate-180 group-focus-within:rotate-180'
        aria-hidden='true'
      ></span>
    </div>
    <div class='editions-panel absolute inset-x-0 top-full z-20'>
      <ul class='editions-panel-content relative rounded bg-background p-1 text-center text-foreground'>
        {editions.map((edition) => (
          <li>
            <a
              href={edition.href}
              class='block whitespace-nowrap px-3 py-1.5 text-sm transition-colors hover:text-primary focus-visible:text-primary focus-visible:outline-none'
            >
              {edition.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</nav>

<style>
  .editions-panel {
    top: 100%;
    left: 0;
    right: 0;
    display: flex;
    justify-content: center;
    padding-top: 0.5rem;
    pointer-events: none;
    visibility: hidden;
    transition: visibility 0s linear 180ms;
  }

  .editions-panel-content {
    width: max-content;
    opacity: 0;
    transform: translateY(0.5rem);
    transition:
      opacity 180ms ease,
      transform 180ms ease;
  }

  .editions-dropdown:hover > .editions-panel,
  .editions-dropdown:focus-within > .editions-panel {
    pointer-events: auto;
    visibility: visible;
    transition-delay: 0s;
  }

  .editions-dropdown:hover > .editions-panel > .editions-panel-content,
  .editions-dropdown:focus-within > .editions-panel > .editions-panel-content {
    opacity: 1;
    transform: translateY(0);
    transition-delay: 0s;
  }

  @media (prefers-reduced-motion: reduce) {
    .editions-panel {
      transition: none;
    }

    .editions-panel-content {
      transform: none;
      transition: none;
    }
  }
</style>
