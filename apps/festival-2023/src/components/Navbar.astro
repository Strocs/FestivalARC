---
import { ARC_2023 } from 'src/data/ARC_2023'
import ButtonLink from './ButtonLink.astro'
import { publicationConfig } from '../../../../editions.config'
import { publicationBase, withBase } from '../utils/publication.js'
import MINCAP from './icons/MINCAP.astro'
import SocialNetworks from './SocialNetworks.astro'

const { locations } = ARC_2023

const sections = [
	{ name: 'inicio', href: '/' },
	{ name: 'festival', href: '/festival' }
]

const { styles, locationId = '' } = Astro.props

const text = locationId.includes('estacionamiento') ? 'text-neutral-700' : 'text-white'

const editionTargets = [
	{ publication: publicationConfig.active, base: '/' },
	...publicationConfig.archives.map((publication) => ({
		publication,
		base: publication.base
	}))
]
	.sort((left, right) => right.publication.year - left.publication.year)
	.map(({ publication, base }) => ({
		label: publication.kind === 'calls'
			? `Convocatoria ${publication.year}`
			: `Festival ARC ${publication.year}`,
		href: base === publicationBase
			? withBase('/')
			: base === '/'
				? '/'
				: `${base}/`
	}))
---

<nav
	class={`${styles.backgroundColor} ${text} grid justify-items-center gap-14 py-24 w-full max-w-md items-center md:place-items-start md:px-14 h-screen top-0 bottom-0 overflow-auto fixed z-40 motion-reduce:animate-none`}
	style={{ opacity: '0', left: '-448px' }}
>
	<div class='grid max-w-[18rem] gap-16'>
		<ul class='grid gap-5'>
			{
				sections.map((section) => (
					<li class='text-4xl transition-all duration-200 ease-in hover:underline'>
						<a href={withBase(section.href)}>{section.name.toUpperCase()}</a>
					</li>
				))
			}
		</ul>
		<details class='editions-dropdown'>
			<summary class='editions-trigger text-4xl transition-all duration-200 ease-in hover:underline'>EDICIONES</summary>
			<div class='editions-panel'>
				<ul class='editions-panel-content grid gap-2 bg-inherit p-3 text-2xl font-light'>
					{
						editionTargets.map((target) => (
							<li class='leading-5 transition-all duration-200 ease-in hover:underline'>
								<a href={target.href}>{target.label}</a>
							</li>
						))
					}
				</ul>
			</div>
		</details>
		<ul class='text-md grid gap-2 font-light'>
			{
				locations.map((location) => (
					<li class='leading-5 transition-all duration-200 ease-in hover:underline'>
						<a href={withBase(`/${location.id}`)}>• {location.title}</a>
					</li>
				))
			}
		</ul>
		<div class='grid gap-6'>
			<ButtonLink
				id={locationId}
				anchor
				href='/PROGRAMA_ARC23.pdf'
				styles={styles}
				className='md:hidden'
			>
				Descarga la Programación
			</ButtonLink>
			<SocialNetworks locationId={locationId} hoverTextColor={styles.hoverTextColor} />
		</div>
		<div class="grid gap-2 text-center">
			<p class=''>Proyecto Financiado por:</p>
			<MINCAP className='w-1/2 mx-auto' />
		</div>
		<div class='flex flex-col pb-6 md:hidden text-center'>
			<p class='text-lg font-bold'>ARC 2023</p>
			<p class='font-light'>
				Desarrollado por <a class='underline' target='_blank' href='https://github.com/Strocs'
					>Strocs</a
				>
			</p>
		</div>
	</div>
</nav>

<style>
	nav {
		transition: left 500ms;
		transition-timing-function: cubic-bezier(0.45, 0.05, 0.55, 0.95);
		overflow-y: scroll;
		scrollbar-width: none; /* Firefox */
		-ms-overflow-style: none; /* Internet Explorer 10+ */
	}

	nav::-webkit-scrollbar {
		/* WebKit */
		width: 0;
		height: 0;
	}

	.editions-dropdown {
		position: relative;
	}

	.editions-panel {
		position: absolute;
		top: 100%;
		left: 0;
		padding-top: 0.5rem;
		pointer-events: none;
		visibility: hidden;
		transition: visibility 0s linear 180ms;
	}

	.editions-panel-content {
		opacity: 0;
		transform: translateY(0.5rem);
		transition:
			opacity 180ms ease,
			transform 180ms ease;
	}

	details:hover > .editions-panel,
	details:focus-within > .editions-panel,
	details[open] > .editions-panel {
	pointer-events: auto;
	visibility: visible;
	transition-delay: 0s;
}

	details:hover > .editions-panel > .editions-panel-content,
	details:focus-within > .editions-panel > .editions-panel-content,
	details[open] > .editions-panel > .editions-panel-content {
	opacity: 1;
	transform: translateY(0);
	transition-delay: 0s;
}

	.editions-trigger {
		cursor: pointer;
		list-style: none;
	}

	.editions-trigger::-webkit-details-marker {
		display: none;
	}

	@media (prefers-reduced-motion: reduce) {
		.editions-panel {
			transition: none;
		}

		.editions-panel-content {
			transform: none;
			transition: none;
		}
	}
</style>
