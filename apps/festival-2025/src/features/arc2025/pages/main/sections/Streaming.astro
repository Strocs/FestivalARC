---
import Title from '@/features/arc2025/components/ui/Title.astro'

const STREAM_DAY_1 = 'T7MGnKZfXQE'
const STREAM_DAY_2 = 'oH3SP24wA84'
---

<section class='px-4'>
  <Title size='md' subTitle='Festival ARC 2025'>Revive</Title>
  <div
    class='mx-auto flex max-w-7xl flex-col items-center justify-center gap-4 lg:-mt-24 lg:flex-row'>
    <a
      href={`https://www.youtube.com/watch?v=${STREAM_DAY_1}`}
      target='_blank'
      rel='noopener noreferrer'
      class='font-dk bg-25-primary text-25-white block w-fit px-6 py-2 text-center text-5xl transition-transform duration-150 hover:-skew-y-4 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-25-accent'>
      Día 1
    </a>
    <a
      href={`https://www.youtube.com/watch?v=${STREAM_DAY_2}`}
      target='_blank'
      rel='noopener noreferrer'
      class='font-dk bg-25-primary text-25-white block w-fit px-6 py-2 text-center text-5xl transition-transform duration-150 hover:-skew-y-4 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-25-accent'>
      Día 2
    </a>
  </div>
</section>
