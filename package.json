{
  "name": "festivalarc",
  "type": "module",
  "version": "3.0.0",
  "private": true,
  "dependencies": {
    "@festivalarc/editions": "workspace:*"
  },
  "scripts": {
    "dev": "node scripts/run-active.mjs dev",
    "start": "node scripts/run-active.mjs start",
    "build": "pnpm --filter @festivalarc/distribution build",
    "build:vercel": "pnpm --filter @festivalarc/distribution build --vercel",
    "preview": "python3 -m http.server 4173 --directory .output",
    "astro": "node scripts/run-active.mjs astro",
    "type": "pnpm -r --if-present run type",
    "lint": "eslint .",
    "test": "pnpm -r --if-present run test",
    "test:coverage": "pnpm -r --if-present run test:coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "visual:capture": "pnpm --filter @festivalarc/visual-review run capture",
    "visual:clean": "pnpm --filter @festivalarc/visual-review run clean"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@typescript-eslint/parser": "^8.74.0",
    "eslint": "^10.15.0",
    "eslint-plugin-astro": "^3.2.2",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.14.0",
    "prettier": "3.10.1",
    "prettier-plugin-astro": "1.1.2",
    "prettier-plugin-tailwindcss": "0.8.1",
    "turbo": "^2.11.13",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@12.23.0"
}
