{
  "name": "festivalarc",
  "type": "module",
  "version": "3.0.0",
  "private": true,
  "dependencies": {
    "@festivalarc/editions": "workspace:*"
  },
  "scripts": {
    "dev": "pnpm --filter festivalarc-2025 dev",
    "start": "pnpm --filter festivalarc-2025 start",
    "build": "pnpm --filter @festivalarc/distribution build",
    "preview": "python3 -m http.server 4173 --directory .output",
    "astro": "pnpm --filter festivalarc-2025 astro",
    "type": "pnpm -r --if-present run type",
    "test": "pnpm -r --if-present run test",
    "test:coverage": "pnpm --filter festivalarc-2025 test:coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "turbo": "^2.5.6",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.18.2+sha512.9fb969fa749b3ade6035e0f109f0b8a60b5d08a1a87fdf72e337da90dcc93336e2280ca4e44f2358a649b83c17959e9993e777c2080879f3801e6f0d999ad3dd"
}
